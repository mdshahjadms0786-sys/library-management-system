# Local MongoDB (works for everything except real multi-document transactions)
MONGO_URI=mongodb://127.0.0.1:27017/librarydb

# MongoDB Atlas free cluster (recommended - real ACID transactions work here)
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/librarydb

PORT=3000
FINE_PER_DAY=5
LOAN_DAYS=14
MAX_BOOKS_PER_MEMBER=3
